{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omra-network.local/schemas/frontmatter.schema.json",
  "title": "Page / post front matter (docs/ENGINE.md)",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "description", "slug", "type", "lang", "date", "status"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 75 },
    "type": { "enum": ["home", "pillar", "guide", "explainer", "checklist", "hub", "local", "data", "news", "trust", "tool"] },
    "tier": { "enum": ["A", "B", "C"] },
    "lang": { "enum": ["fr", "ar"] },
    "date": { "type": "string", "format": "date" },
    "updated": { "type": "string", "format": "date" },
    "status": { "enum": ["published", "draft", "retired"] },
    "primary_keyword": { "type": "string", "minLength": 2 },
    "cluster": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "concept_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "author": { "type": "string", "default": "org" },
    "reviewed_by": { "type": "string" },
    "reviewed_at": { "type": "string", "format": "date" },
    "full_read": { "type": "boolean" },
    "facts_used": { "type": "array", "items": { "type": "string", "pattern": "^fact_[a-z0-9_]+$" } },
    "sources": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["title", "publisher", "url", "accessed"],
        "properties": {
          "title": { "type": "string" }, "publisher": { "type": "string" },
          "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
          "accessed": { "type": "string", "format": "date" }
        }
      }
    },
    "faq": { "type": "array", "maxItems": 12, "items": { "type": "object", "additionalProperties": false, "required": ["q", "a"], "properties": { "q": { "type": "string" }, "a": { "type": "string" } } } },
    "cta": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": { "enum": ["whatsapp", "wikitours", "none"] },
        "topic": { "type": "string" },
        "wt_target": { "type": "string" }
      },
      "if": { "properties": { "type": { "const": "wikitours" } } }, "then": { "required": ["wt_target"] }
    },
    "noindex": { "type": "boolean" },
    "nav_order": { "type": "integer" },
    "translation_key": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
    "requires_legal": { "type": "boolean" },
    "summary": { "type": "string" },
    "page_id": { "type": "integer", "minimum": 1, "maximum": 9999 }
  },
  "allOf": [
    { "if": { "properties": { "type": { "enum": ["pillar", "guide", "explainer", "checklist", "local", "data", "news"] } } },
      "then": { "required": ["tier", "primary_keyword", "cluster", "concept_id"] } },
    { "if": { "required": ["reviewed_by"] }, "then": { "required": ["reviewed_at", "full_read"], "properties": { "full_read": { "const": true } } } }
  ]
}
